{
  "name": "@zeturn/watercolor-core",
  "version": "1.2.10",
  "type": "module",
  "license": "ISC",
  "main": "dist/core.es.js",
  "module": "dist/core.es.js",
  "types": "dist/index.d.ts",
  "style": "src/styles/index.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/core.es.js",
      "default": "./dist/core.es.js"
    },
    "./theme.css": "./src/styles/index.css",
    "./theme-v2.schema.json": "./theme-v2.schema.json"
  },
  "files": [
    "dist",
    "src/styles",
    "theme-v2.schema.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zeturn/watercolor",
    "directory": "packages/core"
  },
  "devDependencies": {
    "ajv": "^8.12.0",
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^3.2.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3"
  }
}
