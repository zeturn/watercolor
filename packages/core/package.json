{
  "name": "@zeturn/watercolor-core",
  "version": "1.2.0",
  "type": "module",
  "main": "dist/core.umd.js",
  "module": "dist/core.es.js",
  "types": "dist/index.d.ts",
  "style": "src/styles/index.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/core.es.js",
      "require": "./dist/core.umd.js"
    },
    "./theme.css": "./src/styles/index.css",
    "./theme-v2.schema.json": "./theme-v2.schema.json",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src/styles",
    "theme-v2.schema.json"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zeturn/watercolor",
    "directory": "packages/core"
  },
  "devDependencies": {
    "ajv": "^8.12.0",
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "jsdom": "^23.2.0",
    "typescript": "^5.3.3"
  }
}
