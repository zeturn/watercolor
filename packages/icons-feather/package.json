{
  "name": "@zeturn/watercolor-icons-feather",
  "version": "1.2.13",
  "type": "module",
  "main": "dist/watercolor-icons-feather.es.js",
  "module": "dist/watercolor-icons-feather.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/watercolor-icons-feather.es.js",
      "default": "./dist/watercolor-icons-feather.es.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js",
      "default": "./dist/legacy.js"
    },
    "./*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js",
      "default": "./dist/icons/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/build-feather-icons.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeturn/watercolor.git",
    "directory": "packages/icons-feather"
  },
  "license": "ISC",
  "peerDependencies": {
    "feather-icons": "^4.29.2"
  },
  "devDependencies": {
    "feather-icons": "^4.29.2"
  }
}
