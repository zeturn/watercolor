{
  "name": "@zeturn/watercolor-svelte",
  "version": "1.2.13",
  "description": "Watercolor UI components for Svelte 5, built on @zeturn/watercolor-core",
  "type": "module",
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/styles/index.css"
  },
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "test": "vitest run",
    "lint": "svelte-check --threshold warning",
    "typecheck": "svelte-check --threshold warning"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zeturn/watercolor",
    "directory": "packages/svelte"
  },
  "peerDependencies": {
    "svelte": "^5.56.10"
  },
  "dependencies": {
    "@zeturn/watercolor-core": "1.2.13"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.7",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.4",
    "jsdom": "^29.1.1"
  }
}
