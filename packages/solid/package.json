{
  "name": "@zeturn/watercolor-solid",
  "version": "1.2.13",
  "description": "Watercolor UI components for SolidJS, built on @zeturn/watercolor-core",
  "type": "module",
  "license": "ISC",
  "main": "dist/watercolor-solid.es.js",
  "module": "dist/watercolor-solid.es.js",
  "types": "./dist/index.d.ts",
  "style": "dist/watercolor-solid.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/watercolor-solid.es.js",
      "default": "./dist/watercolor-solid.es.js"
    },
    "./style.css": "./dist/watercolor-solid.css"
  },
  "files": [
    "dist",
    "style.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "build:types": "tsc -p tsconfig.build.json --noCheck",
    "test": "vitest run",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zeturn/watercolor",
    "directory": "packages/solid"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0",
    "@zeturn/watercolor-icons-feather": "1.2.13"
  },
  "peerDependenciesMeta": {
    "@zeturn/watercolor-icons-feather": {
      "optional": true
    }
  },
  "dependencies": {
    "@zeturn/watercolor-core": "1.2.13",
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "vite-plugin-solid": "^2.11.0",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^3.2.4",
    "jsdom": "^29.1.1"
  }
}
