{
  "name": "watercolor-ui-root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:react": "npm run test -w packages/react",
    "test:vue": "npm run test -w packages/vue",
    "test:core": "npm run test -w packages/core",
    "lint": "npm run lint -w packages/core && npm run lint -w packages/react && npm run lint -w packages/vue",
    "typecheck": "npm run typecheck -w packages/core && npm run typecheck -w packages/react && npm run typecheck -w packages/vue",
    "storybook": "npm run storybook:vue",
    "build-storybook": "npm run build-storybook:vue",
    "storybook:vue": "npm run storybook -w packages/vue",
    "build-storybook:vue": "npm run build-storybook -w packages/vue",
    "storybook:react": "npm run storybook -w packages/react",
    "build-storybook:react": "npm run build-storybook -w packages/react",
    "docs:generate": "node scripts/generate-vitepress-docs.mjs",
    "docs:dev": "npm run docs:generate && vitepress dev docs",
    "docs:build": "npm run docs:generate && vitepress build docs",
    "audit:visual": "node scripts/audit-visual-style.mjs",
    "audit:theme": "node scripts/audit-theme-contract.mjs",
    "audit:composition": "node scripts/audit-composition-layer.mjs",
    "audit:i18n-a11y": "node scripts/audit-i18n-a11y.mjs",
    "audit:docs-examples": "node scripts/audit-docs-examples.mjs",
    "audit:bundle": "node scripts/audit-bundle-size.mjs",
    "typecheck:composition": "npm run build -w packages/core && tsc --noEmit --jsx react-jsx --moduleResolution bundler --module esnext --target es2020 --skipLibCheck tests/types/composition.tsx",
    "typecheck:theme": "npm run build -w packages/core && npm run build -w packages/react && npm run build -w packages/vue && tsc --noEmit --jsx react-jsx --moduleResolution bundler --module esnext --target es2020 --skipLibCheck tests/types/theme-v2.tsx",
    "test:package-theme": "node scripts/test-theme-package.mjs",
    "test:package": "npm run build && npm run check-publish && node scripts/test-theme-package.mjs",
    "audit:api": "node scripts/check-api-parity.mjs",
    "typecheck:public-api": "npm run build -w packages/core && npm run build -w packages/react && npm run build -w packages/vue && tsc --noEmit --jsx react-jsx --moduleResolution bundler --module esnext --target es2020 --strict --skipLibCheck tests/types/public-api.tsx",
    "visual:recipes": "node scripts/visual-check-storybook.mjs",
    "visual:a11y": "node scripts/a11y-check-storybook.mjs",
    "check-publish": "node scripts/check-publish.mjs",
    "release": "node scripts/publish.mjs",
    "release:patch": "node scripts/publish.mjs patch",
    "release:minor": "node scripts/publish.mjs minor",
    "release:major": "node scripts/publish.mjs major",
    "audit:visual:minimal": "node scripts/audit-minimal-visual.mjs"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.0",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "10.3.3",
    "@storybook/addon-links": "10.3.3",
    "@storybook/vue3-vite": "10.3.3",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/vue": "^8.0.1",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/compiler-sfc": "^3.5.17",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.3",
    "ajv": "^8.12.0",
    "axe-core": "^4.12.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-storybook": "^10.3.3",
    "eslint-plugin-vitest": "^0.5.4",
    "eslint-plugin-vue": "^9.19.2",
    "fs-extra": "^11.2.0",
    "jsdom": "^23.2.0",
    "node-fetch": "^3.3.2",
    "storybook": "10.3.3",
    "typescript": "^5.3.3",
    "vite": "^8.0.2",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vitest-canvas-mock": "^0.3.3",
    "vue": "^3.5.17",
    "ws": "^8.18.0"
  },
  "overrides": {
    "@docsearch/js": {
      ".": "4.6.1",
      "@docsearch/css": "4.6.1",
      "@docsearch/react": "4.6.1"
    },
    "vitepress": {
      "@docsearch/css": "4.6.1",
      "@docsearch/js": "4.6.1"
    }
  },
  "keywords": [
    "vue",
    "react",
    "component-library",
    "ui",
    "typescript",
    "minimalist",
    "watercolor",
    "cross-framework",
    "dark-mode",
    "theme"
  ],
  "author": {
    "name": "Watercolor UI Team",
    "email": "support@hollowdata.com",
    "url": "https://hollowdata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zeturn/watercolor"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://hollowdata.com",
  "bugs": {
    "url": "https://github.com/zeturn/watercolor/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=8.0.0"
  },
  "license": "ISC",
  "version": "1.2.8"
}
