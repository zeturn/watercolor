{
  "name": "watercolor-ui-root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:react": "npm run test -w packages/react",
    "test:vue": "npm run test -w packages/vue",
    "lint": "npm run lint --workspaces --if-present",
    "storybook": "npm run storybook:vue",
    "build-storybook": "npm run build-storybook:vue",
    "storybook:vue": "npm run storybook -w packages/vue",
    "build-storybook:vue": "npm run build-storybook -w packages/vue",
    "storybook:react": "npm run storybook -w packages/react",
    "build-storybook:react": "npm run build-storybook -w packages/react",
    "docs:generate": "node scripts/generate-vitepress-docs.mjs",
    "docs:dev": "npm run docs:generate && vitepress dev docs",
    "docs:build": "npm run docs:generate && vitepress build docs",
    "check-publish": "node scripts/check-publish.js",
    "release": "node scripts/publish.js",
    "release:patch": "node scripts/publish.js patch",
    "release:minor": "node scripts/publish.js minor",
    "release:major": "node scripts/publish.js major"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.0.1",
    "@storybook/addon-docs": "9.0.14",
    "@storybook/addon-links": "9.0.14",
    "@storybook/react-vite": "9.0.14",
    "@storybook/vue3-vite": "9.0.14",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.0",
    "@testing-library/vue": "^8.0.1",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/compiler-sfc": "^3.5.17",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.3",
    "ajv": "^8.12.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-storybook": "^9.0.14",
    "eslint-plugin-vitest": "^0.5.4",
    "eslint-plugin-vue": "^9.19.2",
    "fs-extra": "^11.2.0",
    "jsdom": "^23.2.0",
    "node-fetch": "^2.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "9.0.14",
    "typescript": "^5.3.3",
    "vite": "^5.4.12",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vitest-canvas-mock": "^0.3.3",
    "vue": "^3.5.17"
  },
  "keywords": [
    "vue",
    "react",
    "component-library",
    "ui",
    "typescript",
    "minimalist",
    "watercolor",
    "cross-framework",
    "dark-mode",
    "theme"
  ],
  "author": {
    "name": "Watercolor UI Team",
    "email": "support@hollowdata.com",
    "url": "https://hollowdata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zeturn/watercolor"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://hollowdata.com",
  "bugs": {
    "url": "https://github.com/zeturn/watercolor/issues"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "license": "ISC",
  "version": "1.1.37"
}
