{
  "name": "watercolor-ui",
  "version": "1.0.0",
  "description": "一个现代化的极简跨框架组件库",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
